# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# macOS
.DS_Store

# IDEs
.vscode/
.idea/
*.swp

# Data — keep .gitkeep, ignore everything else
data/raw/*
!data/raw/.gitkeep
!data/raw/group_fixtures.csv
!data/raw/knockout_slots.csv
!data/raw/market_probs.csv
data/processed/*
!data/processed/.gitkeep
!data/processed/xgb_home_goals.json
!data/processed/xgb_away_goals.json
!data/processed/xgb_feature_metadata.json

# Outputs — keep .gitkeep, ignore everything else
outputs/*
!outputs/.gitkeep

# Secrets / env vars
.env
*.env
