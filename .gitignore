# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# macOS
.DS_Store

# IDEs
.vscode/
.idea/
*.swp

# Data — keep .gitkeep, ignore everything else
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Outputs — keep .gitkeep, ignore everything else
outputs/*
!outputs/.gitkeep

# Secrets / env vars
.env
*.env
